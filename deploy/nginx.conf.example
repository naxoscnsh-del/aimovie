# 用 Nginx 反代时的参考配置（证书可用 certbot 申请）
server {
    listen 443 ssl;
    server_name video.example.com;
    # ssl_certificate     /etc/letsencrypt/live/video.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/video.example.com/privkey.pem;
    client_max_body_size 30m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;              # 保留 Host，否则写操作会被当成跨站请求拒绝
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;                      # 实时进度推送（SSE）
        proxy_read_timeout 3600s;
    }
}
