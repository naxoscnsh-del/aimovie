# 复制为 .env 后填写

# 演示模式：设为 1 时不调用任何接口、不花钱，用占位素材走完整流程（无需填 Key）
DEMO_MODE=0
DEEPSEEK_API_KEY=
ARK_API_KEY=

# 登录方式（二选一）
# 推荐：成员账号。设置首个管理员，启动后用它登录，在“成员”页添加其他人；启用后 APP_PASSWORD 失效
ADMIN_USER=
ADMIN_PASSWORD=
# 简单模式：共用口令，用户名随便填（记为操作人），所有人都是管理员
APP_PASSWORD=
WORKERS=2
# 团队每月花费上限（USD），0 表示不限制；到 80% 看板提醒，用完后拒绝提交新任务
TEAM_MONTHLY_BUDGET_USD=0
# 经反向代理访问且代理改写了 Host 时，填浏览器里的域名（逗号分隔），否则写操作会被当成跨站请求拒绝
ALLOWED_ORIGIN_HOSTS=
# 部署在子路径（如 https://ainewimage.com/movie/）时填 /movie
BASE_PATH=
# 宿主机端口和监听地址（放在 Nginx 后面时用 127.0.0.1）
APP_PORT=8000
APP_BIND=0.0.0.0
# 国内构建加速（deploy.sh --cn 会自动填写）
BASE_IMAGE=python:3.12-slim
APT_MIRROR=
PIP_INDEX_URL=

# 模型 ID：以火山方舟控制台“开通管理”里实际开通的为准（也可填推理接入点 ep-xxxx）
DEEPSEEK_MODEL=deepseek-chat
SEEDREAM_MODEL=doubao-seedream-4-0-250828
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_RESOLUTION=720p
SEEDANCE_RATIO=adaptive
# 所选 Seedance 版本允许的单段时长（秒），逗号分隔
SEEDANCE_DURATIONS=5,10
# 部分 Seedance 版本默认生成音频；合成时会去掉原声，可设 false 省钱（留空则不传该参数）
SEEDANCE_GENERATE_AUDIO=
# 视频任务失败时自动重试次数
VIDEO_AUTO_RETRY=1

# 旁白配音：火山引擎语音合成（控制台“语音技术”创建应用后获取）
TTS_APPID=
TTS_TOKEN=
TTS_CLUSTER=volcano_tts
TTS_VOICE=zh_female_wanqudashu_moon_bigtts

CANDIDATES_PER_SHOT=2
MAX_PARALLEL_VIDEOS=3

# 预算（USD）
BUDGET_USD=100
BUDGET_WARN_USD=80
REGEN_MARGIN=0.5

# 单价（人民币）——请按方舟/DeepSeek 当前报价填写，P0 实测后校准
USD_CNY=7.2
PRICE_SEEDREAM_PER_IMAGE=
PRICE_SEEDANCE_PER_SECOND=
PRICE_TTS_PER_10K_CHARS=
PRICE_DEEPSEEK_INPUT_PER_MTOK=2
PRICE_DEEPSEEK_OUTPUT_PER_MTOK=8

# ---- 全局账号登录（身份中心 OIDC，与 PMS 一致）----
# AUTH_MODE=oidc 后，成员账号 / APP_PASSWORD 不再生效
# AUTH_MODE=oidc
# OIDC_ISSUER=https://www.ainewimage.com
# OIDC_CLIENT_ID=aimovie
# OIDC_CLIENT_SECRET=
# 回调地址：{PUBLIC_URL}{BASE_PATH}/auth/callback，如 https://www.ainewimage.com/movie/auth/callback
# PUBLIC_URL=https://www.ainewimage.com
# SESSION_SECRET=               # 随机长字符串：openssl rand -hex 32
# OIDC_ADMINS=                  # 固定管理员，逗号分隔，填 account_id(sub) 或姓名
# SESSION_HOURS=12
